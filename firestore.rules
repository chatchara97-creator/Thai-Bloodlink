rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Inventory of blood products
    match /inventory/{itemId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isSignedIn() || true;
    }

    // Requisition and exchange orders
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if false;
    }

    // Health check collection for connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
